{
  "rules": {
    "leaderboards": {
      ".read": true,
      "$duration": {
        ".indexOn": ["score", "ts"],
        "$entry": {
          ".write": "!data.exists() && newData.exists() && ($duration === 'infinite' || $duration === '180' || $duration === '300' || $duration === '600' || $duration === '1800')",
          ".validate": "newData.hasChildren(['name', 'score', 'ts'])",
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
          "score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000000" },
          "ts": { ".validate": "newData.isNumber() && newData.val() <= now + 300000" },
          "elapsed": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "date": { ".validate": "newData.isString()" },
          "week": { ".validate": "newData.isString()" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
